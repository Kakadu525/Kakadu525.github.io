---
const builtAt = new Date().toISOString();
---
<footer class="foot wrap k">
  <a href="#top">↑ наверх</a>
  <span>last deploy: <span id="built" data-built={builtAt}>{builtAt.slice(0, 10)}</span></span>
</footer>
<style>
  .foot {
    display: flex; justify-content: space-between; gap: 12px;
    padding-top: 12px; padding-bottom: 12px; border-top: 1px solid var(--line);
  }
  .foot a:hover { color: var(--accent); }
</style>
