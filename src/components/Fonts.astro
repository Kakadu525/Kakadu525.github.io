---
import latin400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import latin500 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';
import cyrillic400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-cyrillic-400-normal.woff2?url';
import cyrillic500 from '@fontsource/jetbrains-mono/files/jetbrains-mono-cyrillic-500-normal.woff2?url';

// Общий CSS fontsource тянет ещё греческий, вьетнамский и расширенную латиницу, которые сайту
// не нужны, а отдельные файлы подмножеств идут без unicode-range и перекрывают друг друга.
// Поэтому правила собраны здесь: два подмножества, два начертания, диапазоны из fontsource 5.
const RANGES = {
  latin: 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD',
  cyrillic: 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116',
};
const faces = [
  { url: latin400, weight: 400, range: RANGES.latin },
  { url: cyrillic400, weight: 400, range: RANGES.cyrillic },
  { url: latin500, weight: 500, range: RANGES.latin },
  { url: cyrillic500, weight: 500, range: RANGES.cyrillic },
];
const css = faces
  .map((f) => `@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:${f.weight};src:url(${f.url}) format('woff2');unicode-range:${f.range}}`)
  .join('');
---
<link rel="preload" href={cyrillic400} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={latin400} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
