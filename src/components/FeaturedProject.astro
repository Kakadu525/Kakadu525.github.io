---
import type { CollectionEntry } from 'astro:content';
import Preview from './Preview.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, summary, conf, badge, stack, preview } = project.data;
---
<a class="featured t" href={`/projects/${project.id}/`} data-name={title} data-label="repo · featured" data-conf={conf}>
  <span class="info">
    <span class="top"><span class="title">{title}</span>{badge && <span class="k">{badge}</span>}</span>
    <span class="summary">{summary}</span>
    <span class="chips">{stack.slice(0, 4).map((item) => <span class="chip">{item}</span>)}</span>
  </span>
  <Preview kind={preview} />
</a>
<style>
  .featured {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 20px;
    margin-bottom: 14px; padding: 18px 20px;
  }
  .info { display: flex; flex-direction: column; }
  .top { display: flex; align-items: baseline; gap: 10px; margin-bottom: 8px; }
  .title { font-size: 16px; color: var(--text-bright); }
  .summary { margin-bottom: 12px; font-size: 13px; line-height: 1.65; color: var(--text-body); }
  @media (min-width: 1100px) {
    .featured { gap: 32px; padding: 24px 26px; }
    .title { font-size: 18px; }
    .summary { font-size: 14px; }
  }
  @media (max-width: 640px) {
    .featured { grid-template-columns: minmax(0, 1fr); }
  }
</style>
