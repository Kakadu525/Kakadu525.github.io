---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Preview from '../../components/Preview.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}
const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const links = [...(d.repo ? [{ label: 'github', href: d.repo }] : []), ...d.links];
---
<Layout title={`${d.title} · Дмитрий`} description={d.summary}>
  <div class="crumbs wrap k">
    <span>
      <a href="/">kakadu525<span class="accent">_</span></a> /
      <a href="/#projects">projects</a> / <span class="bright">{d.title}</span>
    </span>
    <a href="/#projects">← все проекты</a>
  </div>

  <article class="page wrap">
    <p class="k meta">{d.year} · {d.repo ? 'open source' : 'код не опубликован'}</p>
    <h1>{d.title}</h1>
    <p class="summary">{d.summary}</p>
    {links.length > 0 && (
      <div class="links">
        {links.map((link, i) => (
          <a class:list={['btn', { 'btn-primary': i === 0 }]} href={link.href} rel="noopener">{link.label} →</a>
        ))}
      </div>
    )}

    <figure class="shot t" data-name={d.title} data-label="screenshot" data-conf="0.93">
      {d.screenshot ? (
        <Image src={d.screenshot.src} alt={d.screenshot.alt} width={960} />
      ) : d.animation ? (
        <img src={d.animation.src} alt={d.animation.alt} width={d.animation.width} height={d.animation.height} loading="lazy" decoding="async" />
      ) : (
        <Preview kind={d.preview} size="page" />
      )}
      <figcaption class="k">cam1 · {d.screenshot || d.animation ? 'скриншот' : 'живое превью'}</figcaption>
    </figure>

    <div class="prose"><Content /></div>

    <div class="duo">
      <section class="box">
        <h2 class="h">стек</h2>
        <ul class="chips">{d.stack.map((item) => <li class="chip">{item}</li>)}</ul>
      </section>
      {d.features.length > 0 && (
        <section class="box">
          <h2 class="h">особенности</h2>
          <ul class="features">{d.features.map((item) => <li><span class="accent" aria-hidden="true">→</span> {item}</li>)}</ul>
        </section>
      )}
    </div>
  </article>

  <nav class="pager wrap" aria-label="Другие проекты">
    {prev ? <a href={`/projects/${prev.id}/`}>← {prev.data.title}</a> : <span></span>}
    {next ? <a class="accent" href={`/projects/${next.id}/`}>{next.data.title} →</a> : <span></span>}
  </nav>
</Layout>
<style>
  .crumbs { display: flex; justify-content: space-between; gap: 12px; padding-top: 14px; padding-bottom: 14px; }
  .crumbs a:hover { color: var(--accent); }
  .page { padding-top: 32px; padding-bottom: 40px; }
  .meta { margin-bottom: 10px; }
  h1 { margin-bottom: 10px; font-size: 26px; font-weight: 500; color: var(--text-bright); overflow-wrap: anywhere; }
  .summary { max-width: 600px; margin-bottom: 18px; font-size: 14px; line-height: 1.7; color: var(--text-body); }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .shot { margin-bottom: 32px; background: var(--bg-cam); }
  .shot img { width: 100%; max-height: 560px; object-fit: cover; object-position: top; }
  .shot figcaption { padding: 6px 10px; border-top: 1px solid var(--line); }
  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 28px; }
  .box { padding: 14px 16px; border: 1px solid var(--line); }
  .h { margin-bottom: 10px; }
  .features { font-size: 12px; line-height: 1.8; color: var(--text-dim); }
  .pager {
    display: flex; justify-content: space-between; gap: 12px; padding-top: 12px; padding-bottom: 12px;
    border-top: 1px solid var(--line); font-size: 12px; color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .duo { grid-template-columns: minmax(0, 1fr); }
  }
</style>
